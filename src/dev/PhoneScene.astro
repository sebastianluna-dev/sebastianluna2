---
/**
 * Dev-only phone mockup: three phone captures inside drawn handsets (metal rim, black bezel, camera
 * island, side buttons, glass sheen) on a 4:3 frame. The composition is the `scene` prop. Every length is in `cqw` of the frame, so
 * the picture is the same at any size and can be baked to an image.
 */
import type { ImageMetadata } from 'astro';

interface Screen {
  src: ImageMetadata;
  /** The ground under the camera island, to tint the sheen: a light screen takes a darker one. */
  light?: boolean;
}

interface Props {
  /** Left, centre and right screens; the centre one is the subject. */
  screens: readonly [Screen, Screen, Screen];
  /** Ground colour of the frame. */
  ground: string;
  /** Composition: upright in a row, lying on a surface, or one close with two behind. */
  scene: 'front' | 'table' | 'lead';
  label: string;
}

const { screens, ground, scene, label } = Astro.props;
const places = ['left', 'centre', 'right'] as const;
---

<figure class="phone-scene" data-scene={scene} style={`--scene-ground:${ground}`}>
  <div class="phone-scene__frame">
    <div class="phone-scene__stage">
      {screens.map((screen, index) => (
        <div class:list={['phone', `phone_place_${places[index]}`]}>
          <div class="phone__buttons" />
          <div class="phone__body">
            <div class="phone__screen">
              <img
                class="phone__image"
                src={screen.src.src}
                alt=""
                width={screen.src.width}
                height={screen.src.height}
                decoding="async"
              />
              <div class="phone__island" />
              <div class:list={['phone__sheen', screen.light && 'phone__sheen_on_light']} />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
  <figcaption class="phone-scene__label">{label}</figcaption>
</figure>

<style>
  @layer pf {
    .phone-scene {
      margin: 0;

      & .phone-scene__frame {
        position: relative;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border-radius: var(--pf-radius-cover);
        background: var(--scene-ground);
        container-type: inline-size;
        isolation: isolate;
      }

      /* A soft light from above, so the handsets do not float on a flat colour. */
      & .phone-scene__frame::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(
          ellipse 70% 60% at 50% 38%,
          rgb(255 255 255 / 0.07),
          transparent 70%
        );
      }

      & .phone-scene__stage {
        position: absolute;
        inset: 0;
        perspective: var(--scene-depth, 160cqw);
        transform-style: preserve-3d;
      }

      & .phone-scene__label {
        margin-top: 8px;
        color: var(--pf-text-secondary);
        font-family: var(--pf-font-sans);
        font-size: 13px;
      }
    }

    /* One handset. `--w` is its width; everything else follows from it. */
    .phone {
      --w: 24cqw;
      --rim: calc(var(--w) * 0.012);
      --bezel: calc(var(--w) * 0.034);
      --corner: calc(var(--w) * 0.168);

      position: absolute;
      left: 50%;
      top: 50%;
      width: var(--w);
      aspect-ratio: 1170 / 2440;
      /* Keeps the handset rasterised at full resolution when it turns in 3D. */
      will-change: transform;
      translate: calc(-50% + var(--x, 0cqw)) calc(-50% + var(--y, 0cqw));
      transform: translateZ(var(--z, 0cqw)) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg))
        rotateZ(var(--rz, 0deg));

      /* A handset further back is darker. A veil and not a filter: a filter would rasterise the
         handset before its turn and soften it. */
      &::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: var(--corner);
        background: rgb(0 0 0 / var(--shade, 0));
        pointer-events: none;
      }

      /* The metal rim: brushed graphite with a brighter edge where the light lands. */
      & .phone__body {
        position: absolute;
        inset: 0;
        padding: var(--rim);
        border-radius: var(--corner);
        background: linear-gradient(
          115deg,
          #8b8d92 0%,
          #3a3b3f 18%,
          #1d1e21 46%,
          #48494e 74%,
          #a3a5aa 100%
        );
        box-shadow:
          0 calc(var(--w) * 0.02) calc(var(--w) * 0.05) rgb(0 0 0 / 0.5),
          0 calc(var(--w) * 0.16) calc(var(--w) * 0.34) rgb(0 0 0 / 0.55),
          inset 0 0 0 calc(var(--w) * 0.003) rgb(255 255 255 / 0.28);
      }

      /* The black glass border around the display. */
      & .phone__screen {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        border: var(--bezel) solid #050506;
        border-radius: calc(var(--corner) - var(--rim));
        background: #050506;
        box-shadow: inset 0 0 0 calc(var(--w) * 0.004) rgb(255 255 255 / 0.06);
      }

      & .phone__image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        border-radius: calc(var(--corner) - var(--rim) - var(--bezel));
      }

      & .phone__island {
        position: absolute;
        left: 50%;
        top: 1.9%;
        width: 31%;
        aspect-ratio: 126 / 37;
        translate: -50% 0;
        border-radius: 999px;
        background: #000;

        /* The lens. */
        &::after {
          content: '';
          position: absolute;
          right: 9%;
          top: 50%;
          width: 22%;
          aspect-ratio: 1;
          translate: 0 -50%;
          border-radius: 50%;
          background: radial-gradient(circle at 38% 36%, #2b3350 0%, #0b0d16 46%, #000 70%);
        }
      }

      /* Glass: a diagonal band of reflected light and a faint glow along the top edge. */
      & .phone__sheen {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background:
          linear-gradient(
            118deg,
            transparent 34%,
            rgb(255 255 255 / 0.09) 46%,
            rgb(255 255 255 / 0.02) 56%,
            transparent 62%
          ),
          linear-gradient(180deg, rgb(255 255 255 / 0.06), transparent 22%);
        pointer-events: none;
      }

      & .phone__sheen_on_light {
        opacity: 0.6;
      }

      /* Side buttons, behind the body: action and volume on the left, power on the right. */
      & .phone__buttons {
        position: absolute;
        inset: 0 calc(var(--w) * -0.012);
        background:
          linear-gradient(#55575c, #2a2b2e) left 17% / calc(var(--w) * 0.02) 4.2% no-repeat,
          linear-gradient(#55575c, #2a2b2e) left 25.5% / calc(var(--w) * 0.02) 8% no-repeat,
          linear-gradient(#55575c, #2a2b2e) left 36% / calc(var(--w) * 0.02) 8% no-repeat,
          linear-gradient(#77797e, #2a2b2e) right 30% / calc(var(--w) * 0.02) 12.5% no-repeat;
        border-radius: calc(var(--w) * 0.01);
      }
    }

    /* A · «De frente»: three handsets upright, the outer ones a step back. */
    .phone_place_left {
      --x: -27cqw;
      --y: 5cqw;
      --z: -14cqw;
      --ry: 14deg;
      --shade: 0.2;
    }

    .phone_place_centre {
      --w: 27cqw;
      --y: 1cqw;
    }

    .phone_place_right {
      --x: 27cqw;
      --y: -3cqw;
      --z: -14cqw;
      --ry: -14deg;
      --shade: 0.2;
    }

    /* B · «Sobre la mesa»: the three lying on a surface, seen from above at an angle. */
    .phone-scene[data-scene='table'] .phone-scene__stage {
      --scene-depth: 220cqw;
      transform: rotateX(48deg) rotateZ(-28deg) scale(1.5);
    }

    .phone-scene[data-scene='table'] .phone {
      --w: 22cqw;
      --ry: 0deg;
      --z: 0cqw;
      --shade: 0;
    }

    .phone-scene[data-scene='table'] .phone_place_left {
      --x: -25cqw;
      --y: 9cqw;
    }

    .phone-scene[data-scene='table'] .phone_place_centre {
      --x: 0cqw;
      --y: 0cqw;
    }

    .phone-scene[data-scene='table'] .phone_place_right {
      --x: 25cqw;
      --y: -9cqw;
    }

    /* C · «Protagonista»: the home screen close and turned, the other two out of focus behind. */
    .phone-scene[data-scene='lead'] .phone-scene__stage {
      --scene-depth: 130cqw;
    }

    .phone-scene[data-scene='lead'] .phone_place_centre {
      --w: 33cqw;
      --x: -6cqw;
      --y: 4cqw;
      --z: 10cqw;
      --rx: 8deg;
      --ry: 24deg;
      --rz: -5deg;
    }

    .phone-scene[data-scene='lead'] .phone_place_left {
      --w: 25cqw;
      --x: -36cqw;
      --y: -2cqw;
      --z: -40cqw;
      --rx: 8deg;
      --ry: 24deg;
      --rz: -5deg;
      --shade: 0.4;
      filter: blur(0.5cqw);
    }

    .phone-scene[data-scene='lead'] .phone_place_right {
      --w: 27cqw;
      --x: 30cqw;
      --y: -4cqw;
      --z: -30cqw;
      --rx: 8deg;
      --ry: 24deg;
      --rz: -5deg;
      --shade: 0.3;
      filter: blur(0.35cqw);
    }
  }
</style>
