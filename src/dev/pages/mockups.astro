---
/**
 * Mockup lab (`/dev/mockups`, injected only under `astro dev` by astro.config.ts): the screens of
 * Cuarteto Fratres in perspective, at the sizes a case study shows them, to pick angles with the dev
 * options menu. The captures are real screens of the site (`src/assets/works/cuarteto-fratres/screens`).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import LaptopScene from '../LaptopScene.astro';
import Mockup from '../Mockup.astro';
import PhoneScene from '../PhoneScene.astro';
import cartelera from '@/assets/works/cuarteto-fratres/screens/cartelera.jpg';
import contacto from '@/assets/works/cuarteto-fratres/screens/contacto.jpg';
import cuarteto from '@/assets/works/cuarteto-fratres/screens/cuarteto.jpg';
import hero from '@/assets/works/cuarteto-fratres/screens/hero.jpg';
import integrantes from '@/assets/works/cuarteto-fratres/screens/integrantes.jpg';
import programa from '@/assets/works/cuarteto-fratres/screens/programa.jpg';
import repertorio from '@/assets/works/cuarteto-fratres/screens/repertorio.jpg';
import phoneCartelera from '@/assets/works/cuarteto-fratres/screens/phone-cartelera.jpg';
import phoneHero from '@/assets/works/cuarteto-fratres/screens/phone-hero.jpg';
import phoneIntegrantes from '@/assets/works/cuarteto-fratres/screens/phone-integrantes.jpg';
import semblanza from '@/assets/works/cuarteto-fratres/screens/semblanza.jpg';

const INK = '#0c0e10';
const WHITE = '#fdf6ec';
const CREAM = '#fcead5';

const screens = [
  {
    src: hero,
    label: 'Hero',
    ground: INK,
    focusX: 46,
    focusY: 52,
    // Picked by Sebastian on 2026-11-14.
    fixed: {
      rx: '6deg',
      ry: '5deg',
      rz: '-1deg',
      zoom: '1.2',
      cx: '0%',
      cy: '0%',
      x: '10%',
      y: '0%',
      depth: '500px',
      blur: '1.5px',
      focus: '38%',
    },
  },
  {
    src: repertorio,
    label: 'Repertorio y reproductor',
    ground: WHITE,
    focusX: 38,
    focusY: 50,
    // Picked by Sebastian on 2026-11-14.
    fixed: {
      rx: '17deg',
      ry: '11deg',
      rz: '-6deg',
      zoom: '1.25',
      cx: '0%',
      cy: '0%',
      x: '-3%',
      y: '-4%',
      depth: '500px',
      blur: '0px',
      focus: '38%',
    },
  },
  {
    src: programa,
    label: 'Programa de mano',
    ground: CREAM,
    focusX: 46,
    focusY: 48,
    // Picked by Sebastian on 2026-11-14.
    fixed: {
      rx: '6deg',
      ry: '-6deg',
      rz: '0deg',
      zoom: '1.15',
      cx: '0%',
      cy: '0%',
      x: '-8%',
      y: '-1%',
      depth: '500px',
      blur: '7.5px',
      focus: '82%',
    },
  },
  { src: contacto, label: 'Carta de contacto', ground: CREAM, focusX: 62, focusY: 52 },
  {
    src: semblanza,
    label: 'Semblanza',
    ground: INK,
    focusX: 40,
    focusY: 46,
    // Picked by Sebastian on 2026-11-14.
    fixed: {
      rx: '17deg',
      ry: '27deg',
      rz: '-16.5deg',
      zoom: '1.4',
      cx: '-11%',
      cy: '4%',
      x: '-2%',
      y: '-1%',
      depth: '500px',
      blur: '2.5px',
      focus: '56%',
    },
  },
  {
    src: cuarteto,
    label: 'El cuarteto',
    ground: CREAM,
    focusX: 44,
    focusY: 50,
    // Picked by Sebastian on 2026-11-15.
    fixed: {
      rx: '13deg',
      ry: '-22deg',
      rz: '12.5deg',
      zoom: '1.5',
      cx: '-3%',
      cy: '-5%',
      x: '-2%',
      y: '-1%',
      depth: '500px',
      blur: '2.5px',
      focus: '53%',
    },
  },
  { src: integrantes, label: 'Conoce al cuarteto', ground: INK, focusX: 50, focusY: 58 },
  { src: cartelera, label: 'Cartelera', ground: CREAM, focusX: 36, focusY: 56 },
];

const phoneScreens = [
  { src: phoneIntegrantes },
  { src: phoneHero },
  { src: phoneCartelera, light: true },
] as const;

const phoneScenes = [
  { id: 'front', label: 'A · De frente' },
  { id: 'table', label: 'B · Sobre la mesa' },
  { id: 'lead', label: 'C · Protagonista' },
  { id: 'turn', label: 'D · Fila girada' },
  { id: 'steps', label: 'E · Escalera' },
  { id: 'lead-front', label: 'F · Protagonista de frente' },
  { id: 'lead-soft', label: 'G · Protagonista suave' },
  { id: 'fan', label: 'H · Abanico' },
] as const;
---

<BaseLayout locale="es" title="Mockups · laboratorio" noindex>
  <div class="mockup-lab">
    <h1 class="mockup-lab__title">Mockups del Cuarteto Fratres</h1>
    <p class="mockup-lab__note">
      Abre «Opciones» (abajo a la izquierda), elige un ángulo y afínalo con los controles. Todos los
      encuadres se mueven a la vez. Cuando tengas uno que te guste, pulsa «Copiar valores».
    </p>
    <h2 class="mockup-lab__kicker">Teléfonos: ocho composiciones</h2>
    <div class="mockup-lab__column">
      {phoneScenes.map((scene) => (
        <PhoneScene ground={INK} screens={phoneScreens} scene={scene.id} label={scene.label} />
      ))}
    </div>
    <h2 class="mockup-lab__kicker">Portátil: la semblanza con su mismo giro</h2>
    <LaptopScene
      src={semblanza}
      label="Semblanza en portátil"
      ground={INK}
      rx={17}
      ry={27}
      rz={-16.5}
      width={104}
      x={10}
      y={14}
    />
    <h2 class="mockup-lab__kicker">Tamaño de portada (720)</h2>
    <div class="mockup-lab__column">
      {screens.slice(0, 3).map((screen) => (
        <Mockup {...screen} />
      ))}
    </div>
    <h2 class="mockup-lab__kicker">Tamaño de galería (dos por fila)</h2>
    <div class="mockup-lab__pairs">
      {screens.map((screen) => (
        <Mockup {...screen} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  @layer pf {
    .mockup-lab {
      width: min(var(--pf-case-col), 100%);
      margin-inline: auto;
      padding: var(--pf-case-pad-top) var(--pf-gutter-case) var(--pf-case-pad-bottom);
      box-sizing: content-box;
      font-family: var(--pf-font-sans);
      color: var(--pf-text);

      & .mockup-lab__title {
        margin: 0;
        font-size: 32px;
        font-weight: 500;
        letter-spacing: -0.03em;
      }

      & .mockup-lab__note {
        max-width: 56ch;
        margin: 12px 0 0;
        color: var(--pf-text-secondary);
        font-size: 15px;
        line-height: 1.5;
      }

      & .mockup-lab__kicker {
        margin: 40px 0 14px;
        color: var(--pf-text-secondary);
        font-size: 14px;
        font-weight: 500;
      }

      & .mockup-lab__column {
        display: grid;
        gap: 28px;
      }

      & .mockup-lab__pairs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }
    }
  }
</style>
