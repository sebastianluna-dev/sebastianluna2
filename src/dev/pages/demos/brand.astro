---
/**
 * Preview of the «brand» demo of Cuarteto Fratres (`/dev/demos/brand`, only under `astro dev`):
 * the demo at the two widths a case shows it, the 720 column and a 350 phone column, in both languages.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import DemoFrame from '@/components/demo-frame/DemoFrame.astro';
import { Brand } from '@demos/cuarteto-fratres/brand/Brand';
---

<BaseLayout locale="es" title="Demo · brand" noindex>
  <div class="demo-preview">
    <h1 class="demo-preview__title">brand</h1>
    <div class="demo-preview__wide">
      <DemoFrame project="cuarteto-fratres" name="brand" caption="720 · English">
        <Brand client:load locale="en" />
      </DemoFrame>
    </div>
    <div class="demo-preview__narrow">
      <DemoFrame project="cuarteto-fratres" name="brand-narrow" caption="350 · español">
        <Brand client:load locale="es" />
      </DemoFrame>
    </div>
  </div>
</BaseLayout>

<style>
  @layer pf {
    .demo-preview {
      display: grid;
      gap: 48px;
      justify-items: center;
      padding: var(--pf-case-pad-top) var(--pf-gutter-case) var(--pf-case-pad-bottom);

      & .demo-preview__title {
        margin: 0;
        color: var(--pf-text);
        font: 500 24px / 1.2 var(--pf-font-sans);
      }

      & .demo-preview__wide {
        width: min(720px, 100%);
      }

      & .demo-preview__narrow {
        width: min(350px, 100%);
      }
    }
  }
</style>
