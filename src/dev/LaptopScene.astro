---
/**
 * Dev-only laptop mockup: one 16:10 capture on the display of a drawn notebook (metal lid, black
 * bezel with its camera notch, keyboard deck hinged below) on a 4:3 frame. The lid takes the turn
 * given in `rx`, `ry` and `rz`, the same three angles a flat `Mockup` uses, so a composition picked
 * there carries over. Every length is in `cqw` of the frame, so it can be baked at any size.
 */
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  label: string;
  /** Ground colour of the frame. */
  ground: string;
  /** Turn of the lid, in degrees. */
  rx: number;
  ry: number;
  rz: number;
  /** Width of the lid, in % of the frame. */
  width?: number;
  /** Shift of the notebook from the centre of the frame, in % of its width. */
  x?: number;
  y?: number;
}

const { src, label, ground, rx, ry, rz, width = 60, x = 0, y = 0 } = Astro.props;
const style = `--scene-ground:${ground};--rx:${rx}deg;--ry:${ry}deg;--rz:${rz}deg;--w:${width}cqw;--x:${x}cqw;--y:${y}cqw`;

/** The live controls under the scene: custom property, unit, range and starting value. */
const TUNERS = [
  { name: 'rx', label: 'Giro X', unit: 'deg', min: -40, max: 40, value: rx },
  { name: 'ry', label: 'Giro Y', unit: 'deg', min: -45, max: 45, value: ry },
  { name: 'rz', label: 'Giro Z', unit: 'deg', min: -30, max: 30, value: rz },
  { name: 'w', label: 'Ancho', unit: 'cqw', min: 40, max: 180, value: width },
  { name: 'x', label: 'Mover X', unit: 'cqw', min: -50, max: 50, value: x },
  { name: 'y', label: 'Mover Y', unit: 'cqw', min: -50, max: 50, value: y },
  { name: 'depth', label: 'Perspectiva', unit: 'cqw', min: 50, max: 400, value: 150 },
  { name: 'hinge', label: 'Teclado', unit: 'deg', min: 20, max: 90, value: 62 },
];
---

<figure class="laptop-scene" style={style}>
  <div class="laptop-scene__frame">
    <div class="laptop-scene__stage">
      <div class="laptop">
        <div class="laptop__lid">
          <div class="laptop__display">
            <img
              class="laptop__image"
              src={src.src}
              alt=""
              width={src.width}
              height={src.height}
              decoding="async"
            />
            <div class="laptop__notch"></div>
            <div class="laptop__sheen"></div>
          </div>
        </div>
        <div class="laptop__deck">
          <div class="laptop__keys"></div>
          <div class="laptop__pad"></div>
        </div>
      </div>
    </div>
  </div>
  <figcaption class="laptop-scene__label">{label}</figcaption>
  <details class="laptop-scene__tune" data-laptop-tune>
    <summary>Ajustar</summary>
    <div class="laptop-scene__tuners">
      {TUNERS.map((tuner) => (
        <label class="laptop-scene__tuner">
          <span>{tuner.label}</span>
          <input
            type="range"
            min={tuner.min}
            max={tuner.max}
            step="0.5"
            value={tuner.value}
            data-var={tuner.name}
            data-unit={tuner.unit}
          />
          <output>{tuner.value}</output>
        </label>
      ))}
    </div>
    <button type="button" class="laptop-scene__copy" data-laptop-copy>
      Copiar valores
    </button>
    <code class="laptop-scene__values" data-laptop-values></code>
  </details>
</figure>

<script>
  /** Each range paints its custom property on the figure; the line below lists the values. */
  for (const panel of document.querySelectorAll<HTMLElement>('[data-laptop-tune]')) {
    const figure = panel.closest<HTMLElement>('figure');
    const values = panel.querySelector<HTMLElement>('[data-laptop-values]');
    const inputs = [...panel.querySelectorAll<HTMLInputElement>('input[type="range"]')];
    if (!figure || !values) continue;
    const label = figure.querySelector('figcaption')?.textContent?.trim() ?? '';
    const read = () =>
      JSON.stringify({
        mockup: label,
        ...Object.fromEntries(inputs.map((i) => [i.dataset.var, Number(i.value)])),
      });
    const paint = () => {
      for (const input of inputs) {
        figure.style.setProperty(`--${input.dataset.var}`, `${input.value}${input.dataset.unit}`);
        const output = input.nextElementSibling;
        if (output) output.textContent = input.value;
      }
      values.textContent = read();
    };
    for (const input of inputs) input.addEventListener('input', paint);
    panel.querySelector('[data-laptop-copy]')?.addEventListener('click', () => {
      void navigator.clipboard.writeText(read());
    });
    values.textContent = read();
  }
</script>

<style>
  @layer pf {
    .laptop-scene {
      margin: 0;

      & .laptop-scene__frame {
        position: relative;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border-radius: var(--pf-radius-cover);
        background: var(--scene-ground);
        container-type: inline-size;
        isolation: isolate;
      }

      /* A soft light behind the notebook, so it does not float on a flat colour. */
      & .laptop-scene__frame::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(
          ellipse 75% 65% at 50% 42%,
          rgb(255 255 255 / 0.08),
          transparent 70%
        );
      }

      & .laptop-scene__stage {
        position: absolute;
        inset: 0;
        perspective: var(--depth, 150cqw);
        transform-style: preserve-3d;
      }

      & .laptop-scene__tune {
        margin-top: 8px;
        color: var(--pf-text-secondary);
        font-family: var(--pf-font-sans);
        font-size: 13px;
      }

      & .laptop-scene__tuners {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 6px 20px;
        margin: 10px 0;
      }

      & .laptop-scene__tuner {
        display: grid;
        grid-template-columns: 84px 1fr 44px;
        align-items: center;
        gap: 8px;
      }

      & .laptop-scene__copy {
        margin-right: 10px;
        padding: 4px 10px;
        border: 1px solid currentColor;
        border-radius: 6px;
        background: none;
        color: inherit;
        font: inherit;
        cursor: pointer;
      }

      & .laptop-scene__values {
        font-size: 12px;
        overflow-wrap: anywhere;
      }

      & .laptop-scene__label {
        margin-top: 8px;
        color: var(--pf-text-secondary);
        font-family: var(--pf-font-sans);
        font-size: 13px;
      }
    }

    /* The lid carries the turn; the deck hangs from its lower edge. */
    .laptop {
      --lid-h: calc(var(--w) * 0.66);
      --rim: calc(var(--w) * 0.006);

      position: absolute;
      left: 50%;
      top: 50%;
      width: var(--w);
      height: var(--lid-h);
      translate: calc(-50% + var(--x)) calc(-62% + var(--y));
      transform: rotateX(var(--rx)) rotateY(var(--ry)) rotateZ(var(--rz));
      transform-style: preserve-3d;
      will-change: transform;

      /* Metal lid seen from the display side: a thin rim around the black glass. */
      & .laptop__lid {
        position: absolute;
        inset: 0;
        padding: var(--rim);
        border-radius: calc(var(--w) * 0.022) calc(var(--w) * 0.022) calc(var(--w) * 0.008)
          calc(var(--w) * 0.008);
        background: linear-gradient(120deg, #9a9ca1, #3b3c40 30%, #232427 60%, #7c7e83);
        box-shadow: 0 calc(var(--w) * 0.03) calc(var(--w) * 0.12) rgb(0 0 0 / 0.5);
      }

      & .laptop__display {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        border: calc(var(--w) * 0.012) solid #050506;
        border-bottom-width: calc(var(--w) * 0.02);
        border-radius: calc(var(--w) * 0.017) calc(var(--w) * 0.017) calc(var(--w) * 0.004)
          calc(var(--w) * 0.004);
        background: #050506;
      }

      & .laptop__image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        border-radius: calc(var(--w) * 0.006);
      }

      & .laptop__notch {
        position: absolute;
        left: 50%;
        top: 0;
        width: 12%;
        height: 3.4%;
        translate: -50% 0;
        border-radius: 0 0 calc(var(--w) * 0.008) calc(var(--w) * 0.008);
        background: #050506;
      }

      /* Glass: a diagonal band of reflected light. */
      & .laptop__sheen {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          112deg,
          transparent 38%,
          rgb(255 255 255 / 0.07) 50%,
          rgb(255 255 255 / 0.015) 60%,
          transparent 66%
        );
        pointer-events: none;
      }

      /* The keyboard deck, hinged on the lower edge of the lid and opened towards the reader. */
      & .laptop__deck {
        position: absolute;
        left: 0;
        top: 100%;
        width: 100%;
        height: calc(var(--lid-h) * 1.02);
        transform-origin: top;
        transform: rotateX(var(--hinge, 62deg));
        border-radius: calc(var(--w) * 0.006) calc(var(--w) * 0.006) calc(var(--w) * 0.03)
          calc(var(--w) * 0.03);
        background: linear-gradient(180deg, #1b1c1f 0%, #3a3b40 6%, #55575d 55%, #74767c 100%);
        box-shadow:
          inset 0 0 0 calc(var(--w) * 0.002) rgb(255 255 255 / 0.2),
          inset 0 calc(var(--w) * -0.006) 0 rgb(255 255 255 / 0.25),
          0 calc(var(--w) * 0.05) calc(var(--w) * 0.14) rgb(0 0 0 / 0.6);
      }

      /* The key well: rows of dark keys drawn with two crossed gradients. */
      & .laptop__keys {
        position: absolute;
        left: 7%;
        right: 7%;
        top: 9%;
        height: 46%;
        border-radius: calc(var(--w) * 0.008);
        background:
          repeating-linear-gradient(90deg, transparent 0 6.4%, #17181a 6.4% 7.14%),
          repeating-linear-gradient(180deg, #2a2b2f 0 14.6%, #17181a 14.6% 16.66%);
        box-shadow: 0 0 0 calc(var(--w) * 0.004) #17181a;
      }

      & .laptop__pad {
        position: absolute;
        left: 30%;
        right: 30%;
        top: 62%;
        bottom: 5%;
        border-radius: calc(var(--w) * 0.008);
        background: rgb(255 255 255 / 0.06);
        box-shadow: inset 0 0 0 calc(var(--w) * 0.0015) rgb(0 0 0 / 0.35);
      }
    }
  }
</style>
