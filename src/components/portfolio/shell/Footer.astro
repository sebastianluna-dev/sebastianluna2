---
/**
 * Site footer (design-spec §3.1 "Footer", §4 shell; home.md "Footer"; SH-09…SH-13, SH-16…SH-18):
 * one `<footer>` (contentinfo) that is the reference's large footer from 810 px and its mobile footer
 * below, switched by CSS instead of rendering two copies.
 *
 * - Stage (`FooterStage`): the selection frame with the giant name, the divider and the social
 *   links, as tall as its content. It persists across navigations in the same language
 *   (`transition:persist`), so the scene plays once; its state is `data-footer-scene`.
 * - Strip: copyright and language switch in a centred, wrapping row of at most 560 px, padding
 *   0 20 4 (P: 0 12 4). On phones the footer keeps 96 px free for the bottom nav.
 */
import type { Locale } from '@/i18n/locales';
import Copyright from './Copyright.astro';
import FooterStage from './FooterStage.astro';
import LocaleSwitch from './LocaleSwitch.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="site-footer">
  <FooterStage locale={locale} />
  <div class="site-footer__strip">
    <div class="site-footer__strip-inner">
      <Copyright locale={locale} />
      <LocaleSwitch locale={locale} />
    </div>
  </div>
</footer>

<script>
  // SH-09…SH-16 and the copyright year; binds on astro:page-load.
  import '@/components/portfolio/shell/footer-stage.client';
</script>

<style>
  @layer pf {
    .site-footer {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      overflow: clip;
      background: var(--pf-footer-bg);

      @media (max-width: 809.98px) {
        /* Room for the bottom pill nav. */
        padding-block-end: 96px;
      }
    }

    .site-footer__strip {
      display: flex;
      flex: none;
      justify-content: center;
      width: 100%;
      padding: 0 20px 4px;
      overflow: clip;

      @media (max-width: 809.98px) {
        padding-inline: 12px;
      }
    }

    .site-footer__strip-inner {
      display: flex;
      flex: 1 0 0;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 0 16px;
      width: 1px;
      max-width: var(--pf-text-col);
    }
  }
</style>
