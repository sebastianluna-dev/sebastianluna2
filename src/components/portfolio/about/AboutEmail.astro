---
/**
 * /about Email button (about-spec §5.1, fase7-plan §1.2): the text Aqua button with the address. It is
 * a `mailto:` link (decision 22); with the async clipboard, `about-email.client.ts` copies the address
 * instead and confirms it with the reference's speech bubble and a polite live region. `copyEmail` is
 * not passed to AquaButton, so the pill nav's toast never fires for this button.
 */
import type { Locale } from '@/i18n/locales';
import { format, getMessages } from '@/i18n/t';
import { CONTACT_EMAILS, mailtoHref } from '@/data/profile';
import { AquaButton } from '@/components/portfolio/ui/AquaButton';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { about } = getMessages(locale);
const email = CONTACT_EMAILS[locale];
---

<div
  class="about-email"
  data-about-email={email}
  data-copied={about.hero.email.copied}
  data-failed={about.hero.email.failed}
>
  <AquaButton
    client:idle
    href={mailtoHref(locale)}
    label={email}
    accessibleName={format(about.hero.email.copyLabel, { email })}
    variant="neutral"
  />
  <span class="about-email__bubble" data-about-email-bubble aria-hidden="true" hidden>
    <span class="about-email__bubble-text" data-about-email-text></span>
    <svg
      class="about-email__tail"
      viewBox="0 0 18 16"
      width="18"
      height="16"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M1 0h17v16C12 13 5 8 1 0Z" fill="currentColor"></path>
    </svg>
  </span>
  <span class="sr-only" role="status" aria-live="polite" data-about-email-status></span>
</div>

<script>
  import { startAboutEmail } from './about-email.client';

  startAboutEmail();
</script>

<style>
  @layer pf {
    .about-email {
      position: relative;
      display: inline-flex;

      .about-email__bubble {
        position: absolute;
        right: 10px;
        bottom: calc(100% + 4px);
        z-index: 2;
        padding: 10px 15px;
        border-radius: 17px 19px 16px 17px;
        background: var(--pf-bubble-bg);
        /* drop-shadow, not box-shadow, so the tail casts it too. */
        filter: drop-shadow(var(--pf-bubble-shadow));
        color: var(--pf-bubble-text);
        font-family: var(--pf-font-sans);
        font-size: 14px;
        font-weight: 600;
        line-height: 18px;
        letter-spacing: -0.02em;
        white-space: nowrap;
        pointer-events: none;
        transform-origin: 70% 100%;
        opacity: 0;

        &[hidden] {
          display: none;
        }
      }

      .about-email__tail {
        position: absolute;
        right: 6px;
        bottom: -10px;
        color: var(--pf-bubble-bg);
      }
    }
  }
</style>
