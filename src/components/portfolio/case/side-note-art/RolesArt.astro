---
/**
 * Side note art `roles`: a visitor, a gate and the data behind it, joined by dashed wires; on hover a
 * request runs along each wire (`pf-note-hv-run`) and the gate lifts (`pf-note-hv-lift`). CA-14.
 */
---

<div class="roles-art">
  <span class="roles-art__node">
    <span class="roles-art__dot roles-art__dot_visitor">
      <svg width="14" height="14" viewBox="0 0 14 14" focusable="false">
        <circle cx="7" cy="5" r="2.6"></circle>
        <path d="M2.2 12.6c.6-2.4 2.5-3.8 4.8-3.8s4.2 1.4 4.8 3.8"></path>
      </svg>
    </span>
    <span class="roles-art__caption"></span>
  </span>
  <span class="roles-art__wire">
    <span class="roles-art__request pf-note-hv-run"></span>
  </span>
  <span class="roles-art__node pf-note-hv-lift">
    <span class="roles-art__dot roles-art__dot_gate">
      <svg width="14" height="14" viewBox="0 0 14 14" focusable="false">
        <path d="M7 1.2 12 3v4c0 3-2.2 5-5 5.8C4.2 12 2 10 2 7V3Z"></path>
      </svg>
    </span>
    <span class="roles-art__caption"></span>
  </span>
  <span class="roles-art__wire">
    <span class="roles-art__request pf-note-hv-run"></span>
  </span>
  <span class="roles-art__node">
    <span class="roles-art__dot roles-art__dot_data">
      <svg width="14" height="14" viewBox="0 0 14 14" focusable="false">
        <ellipse cx="7" cy="3.4" rx="4.6" ry="1.9"></ellipse>
        <path d="M2.4 3.4v7.2c0 1 2 1.9 4.6 1.9s4.6-.9 4.6-1.9V3.4"></path>
        <path d="M2.4 7c0 1 2 1.9 4.6 1.9S11.6 8 11.6 7"></path>
      </svg>
    </span>
    <span class="roles-art__caption"></span>
  </span>
</div>

<style>
  @layer pf {
    .roles-art {
      --note-accent: var(--pf-accent-violet);
      --roles-art-dot: 34px;

      display: flex;
      align-items: flex-start;
    }

    .roles-art__node {
      display: flex;
      flex-direction: column;
      gap: 6px;
      align-items: center;
    }

    .roles-art__dot {
      display: grid;
      place-items: center;
      width: var(--roles-art-dot);
      height: var(--roles-art-dot);
      border-radius: 50%;
    }

    .roles-art__dot_visitor {
      background: var(--note-surface-2);
      box-shadow: inset 0 0 0 1px var(--note-line);
      fill: var(--note-ink-2);
    }

    .roles-art__dot_gate {
      background: var(--note-accent);
      box-shadow: 0 4px 12px color-mix(in srgb, var(--note-accent) 35%, transparent);
      fill: var(--note-on-accent);
    }

    .roles-art__dot_data {
      background: var(--note-inverse);
      fill: none;
      stroke: var(--note-inverse-ink);
      stroke-width: 1.3;
    }

    .roles-art__caption {
      width: 22px;
      height: 5px;
      border-radius: 3px;
      background: var(--note-line-2);
    }

    .roles-art__wire {
      position: relative;
      width: 24px;
      height: var(--roles-art-dot);
      margin: 0 3px;

      &::before {
        position: absolute;
        top: calc(var(--roles-art-dot) / 2 - 0.75px);
        right: 0;
        left: 0;
        border-top: 1.5px dashed var(--note-ink-3);
        content: '';
      }
    }

    .roles-art__request {
      position: absolute;
      top: calc(var(--roles-art-dot) / 2 - 3px);
      left: -2px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--note-accent);
      opacity: 0;
    }
  }
</style>
