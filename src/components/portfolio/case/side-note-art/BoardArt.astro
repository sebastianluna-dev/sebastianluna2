---
/**
 * Side note art `board` (chess): a card with a 4 × 3 corner of a board and a pawn that steps one
 * square up on hover (`pf-note-hv-up`), next to a short checklist whose last tick appears (`pf-note-hv-on`). CA-14.
 */
const SQUARE = 18;
const COLS = 4;
const ROWS = 3;
const squares = Array.from({ length: COLS * ROWS }, (_, index) => ({
  x: (index % COLS) * SQUARE,
  y: Math.floor(index / COLS) * SQUARE,
  dark: (index % COLS) % 2 !== Math.floor(index / COLS) % 2,
}));
---

<div class="board-art">
  <div class="board-art__card">
    <svg
      class="board-art__board"
      width={COLS * SQUARE}
      height={ROWS * SQUARE}
      viewBox={`0 0 ${COLS * SQUARE} ${ROWS * SQUARE}`}
      focusable="false"
    >
      {squares.map((square) => (
        <rect
          class:list={['board-art__square', { 'board-art__square_dark': square.dark }]}
          x={square.x}
          y={square.y}
          width={SQUARE}
          height={SQUARE}
        />
      ))}
      <rect
        class="board-art__target pf-note-hv-on"
        x="19"
        y="1"
        width="16"
        height="16"
        rx="3"
      ></rect>
      <path
        class="board-art__rook"
        d="M58 39h2v2h2v-2h2v2h2v-2h2v4l-1.5 1.5V48l2 2v2H57v-2l2-2v-5.5L57.5 43v-4Z"
      ></path>
      <g class="board-art__pawn pf-note-hv-up">
        <circle cx="27" cy="23.5" r="3.2"></circle>
        <path d="M24.6 27.4h4.8l1.6 5.6h1.5v2H21.5v-2H23Z"></path>
      </g>
    </svg>
  </div>
  <ul class="board-art__list">
    <li>
      <span class="board-art__tick"></span>
      <span class="board-art__bar"></span>
    </li>
    <li>
      <span class="board-art__tick"></span>
      <span class="board-art__bar board-art__bar_short"></span>
    </li>
    <li>
      <span class="board-art__tick board-art__tick_open">
        <span class="board-art__tick-fill pf-note-hv-on"></span>
      </span>
      <span class="board-art__bar"></span>
    </li>
  </ul>
</div>

<style>
  @layer pf {
    .board-art {
      --note-accent: var(--pf-accent-teal);
      --board-art-up: -18px; /* one square */

      display: flex;
      gap: 12px;
      align-items: center;
    }

    .board-art__card {
      padding: 8px;
      border-radius: 14px;
      background: var(--note-surface);
      box-shadow: var(--note-shadow);
    }

    .board-art__board {
      clip-path: inset(0 round 6px);
    }

    .board-art__square {
      fill: var(--note-surface-2);
    }

    .board-art__square_dark {
      fill: var(--note-line-2);
    }

    .board-art__target {
      fill: none;
      stroke: var(--note-accent);
      stroke-width: 2;
    }

    .board-art__rook {
      fill: var(--note-ink);
    }

    .board-art__pawn {
      --d: var(--board-art-up);

      fill: var(--note-accent);
    }

    .board-art__list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;

      & li {
        display: flex;
        gap: 6px;
        align-items: center;
      }
    }

    .board-art__tick {
      position: relative;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--note-accent);
    }

    .board-art__tick_open {
      background: transparent;
      box-shadow: inset 0 0 0 1.5px var(--note-ink-3);
    }

    .board-art__tick-fill {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: var(--note-accent);
    }

    .board-art__bar {
      width: 40px;
      height: 6px;
      border-radius: 3px;
      background: var(--note-line-2);
    }

    .board-art__bar_short {
      width: 28px;
    }
  }
</style>
