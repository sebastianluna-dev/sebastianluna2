---
/**
 * Round 60 px avatar linking to LinkedIn (HE-13 appear, HE-14 hover). On a fine pointer it lifts 4 px
 * with a soft shadow and shows the profile handle in a tooltip 28 px above; the handle is a visual
 * repeat of the link name, so it is hidden from assistive technology. The photo is served square at
 * exactly 1x/2x/3x of `HERO_AVATAR_PX` (60/120/180 px; `AVATAR_IMAGE`: AVIF, WebP fallback).
 */
import { getImage } from 'astro:assets';
import type { Locale } from '@/i18n/locales';
import { getMessages } from '@/i18n/t';
import { AVATAR_IMAGE, HERO_AVATAR_PX, PROFILE } from '@/data/profile';
import AppearMotion from '@/components/motion/AppearMotion.astro';
import { HOME_APPEAR } from '@/components/motion/presets';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { hero } = getMessages(locale);

/** Drawn size in CSS px, the `--pf-hero-avatar` token (`tokens.test.ts` keeps both equal). */
const SIZE = HERO_AVATAR_PX;
const { src, formats, densities, fit, position } = AVATAR_IMAGE;
const [avif, webp] = await Promise.all(
  formats.map((format) =>
    getImage({ src, format, width: SIZE, height: SIZE, densities: [...densities], fit, position }),
  ),
);
---

<AppearMotion appear={HOME_APPEAR.avatar} class="hero-avatar">
  <a class="hero-avatar__link" href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer">
    <span class="hero-avatar__frame">
      <picture>
        <source type="image/avif" srcset={avif.srcSet.attribute} />
        <img
          class="hero-avatar__image"
          src={webp.src}
          srcset={webp.srcSet.attribute}
          alt={hero.avatar.label}
          width={SIZE}
          height={SIZE}
          loading="eager"
          decoding="async"
          draggable="false"
        />
      </picture>
    </span>
    <span class="hero-avatar__tooltip" aria-hidden="true">
      {PROFILE.linkedinHandle}
    </span>
  </a>
</AppearMotion>

<style>
  @layer pf {
    .hero-avatar {
      --hero-avatar-size: var(--pf-hero-avatar);
      --hero-avatar-lift: -4px;
      /* Reference XProfileAvatar values. */
      --hero-avatar-shadow: var(--pf-avatar-hover-shadow);
      --hero-avatar-tooltip-bg: var(--pf-avatar-tooltip-bg);
      --hero-avatar-tooltip-offset: -28px;

      position: relative;
      flex: none;
      width: var(--hero-avatar-size);
      height: var(--hero-avatar-size);
    }

    .hero-avatar__link {
      position: relative;
      display: block;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      color: inherit;
      text-decoration: none;
      transition:
        transform var(--pf-dur-fast) ease,
        box-shadow var(--pf-dur-fast) ease;

      &:focus-visible {
        border-radius: 50%;
      }

      @media (prefers-reduced-motion: reduce) {
        transition: none;
      }
    }

    .hero-avatar__frame {
      position: relative;
      display: block;
      width: 100%;
      height: 100%;
      overflow: hidden;
      border-radius: 50%;
      background: var(--pf-surface);
    }

    .hero-avatar__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      user-select: none;
    }

    .hero-avatar__tooltip {
      position: absolute;
      top: var(--hero-avatar-tooltip-offset);
      left: 50%;
      padding: 4px 10px;
      border-radius: 4px;
      background: var(--hero-avatar-tooltip-bg);
      color: var(--pf-avatar-tooltip-text);
      font-family: var(--pf-font-system);
      font-size: 12px;
      line-height: normal;
      white-space: nowrap;
      pointer-events: none;
      user-select: none;
      translate: -50% 0;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--pf-dur-icon) ease,
        visibility var(--pf-dur-icon) ease;
    }

    @media (hover: hover) and (pointer: fine) {
      .hero-avatar__link:hover {
        transform: translateY(var(--hero-avatar-lift));
        box-shadow: var(--hero-avatar-shadow);
      }

      .hero-avatar__link:hover .hero-avatar__tooltip {
        opacity: 1;
        visibility: visible;
      }
    }

    .hero-avatar__link:focus-visible .hero-avatar__tooltip {
      opacity: 1;
      visibility: visible;
    }
  }
</style>
