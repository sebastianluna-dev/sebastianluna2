---
/**
 * The one seam between the portfolio and a live demo (`src/demos/<project>/**`): a case block that
 * holds the demo inside `.demo-root`, where nothing of the portfolio's theme reaches (CSS layer
 * `demos`, `all: initial`, the project's own `--d-*` tokens), and its caption in the body style.
 *
 * The demo goes in the slot as a React island, imported statically by the MDX (a dynamic tag cannot
 * hydrate): `<DemoFrame project="…" name="…" caption="…"><Demo client:visible /></DemoFrame>`.
 * The island renders on the server with its real controls and reserves its own height, so the page
 * neither jumps on hydration nor goes blank without JavaScript.
 *
 * `interactive` marks a demo the reader is meant to use: a drawn pointer rests on its first thing to
 * press (`cue`), with a ring that beats, and leaves for good at the reader's first press or key
 * inside the demo. It is decoration (`aria-hidden`): the caption says what to do.
 */
import '@demos/shared/demo-root.css';

interface Props {
  /** Folder of `src/demos`: scopes the project's tokens (`data-demo`). */
  project: string;
  /** Key of the demo, the one the case lists in its frontmatter `demos`. */
  name: string;
  /** One line under the demo, in the body style. */
  caption?: string;
  /** The reader is meant to use this demo: it carries the pointer. */
  interactive?: boolean;
  /** Where the pointer rests, as `left top` in % of the demo: its first thing to press. */
  cue?: string;
  /** The same on the phone column, where the demo is laid out differently. */
  cueNarrow?: string;
}

const {
  project,
  name,
  caption,
  interactive = false,
  cue = '50% 50%',
  cueNarrow = cue,
} = Astro.props;
const [cueX = '50%', cueY = '50%'] = cue.split(' ');
const [narrowX = cueX, narrowY = cueY] = cueNarrow.split(' ');
const cueStyle = `--cue-x:${cueX};--cue-y:${cueY};--cue-narrow-x:${narrowX};--cue-narrow-y:${narrowY}`;
---

<figure
  class="demo-frame"
  data-case-block
  data-demo-frame={name}
  data-demo-interactive={interactive ? '' : undefined}
>
  <div class="demo-frame__stage">
    <div class="demo-root" data-demo={project}>
      <slot />
    </div>
    {interactive && (
      <span class="demo-frame__cue" style={cueStyle} aria-hidden="true">
        <span class="demo-frame__ring" />
        <svg class="demo-frame__pointer" viewBox="0 0 20 20">
          <path d="M5 2.8 15.2 11l-4.5.5 2.6 5-1.9 1-2.6-5.1-3.3 3.1Z" />
        </svg>
      </span>
    )}
  </div>
  {caption && <figcaption class="demo-frame__caption pf-prose">{caption}</figcaption>}
</figure>

<script>
  // The pointer has done its job once the reader presses or types inside the demo.
  function watchDemoCues(): void {
    for (const frame of document.querySelectorAll<HTMLElement>('[data-demo-interactive]')) {
      const root = frame.querySelector('.demo-root');
      if (!root || 'demoWatched' in frame.dataset) continue;
      frame.dataset.demoWatched = '';
      const used = () => {
        frame.dataset.demoUsed = '';
        root.removeEventListener('pointerdown', used);
        root.removeEventListener('keydown', used);
      };
      root.addEventListener('pointerdown', used);
      root.addEventListener('keydown', used);
    }
  }

  watchDemoCues();
  document.addEventListener('astro:page-load', watchDemoCues);
</script>

<style>
  @layer pf {
    .demo-frame {
      display: flex;
      flex-direction: column;
      gap: var(--pf-case-text-gap);
      margin: 0;

      & .demo-frame__stage {
        position: relative;
      }

      & .demo-frame__caption {
        width: min(var(--pf-text-col), 100%);
        margin-inline: auto;
      }

      /* The pointer: white with a dark edge, so it shows on any ground of a demo. */
      & .demo-frame__cue {
        position: absolute;
        left: var(--cue-x);
        top: var(--cue-y);
        z-index: 2;
        filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.45));
        pointer-events: none;
        transition: opacity 0.3s ease;

        @media (max-width: 809.98px) {
          left: var(--cue-narrow-x);
          top: var(--cue-narrow-y);
        }
      }

      & .demo-frame__pointer {
        position: relative;
        display: block;
        width: 26px;
        height: 26px;
        fill: #fff;
        stroke: #0a0a0a;
        stroke-width: 1.2;
        stroke-linejoin: round;
        animation: demo-frame-nudge 1.8s ease-in-out infinite;
      }

      & .demo-frame__ring {
        position: absolute;
        left: 4px;
        top: 2px;
        width: 34px;
        height: 34px;
        translate: -50% -50%;
        border: 2px solid #fff;
        border-radius: 50%;
        box-shadow: 0 0 0 1px rgb(0 0 0 / 0.35);
        animation: demo-frame-ring 1.8s ease-out infinite;
      }

      &[data-demo-used] .demo-frame__cue {
        opacity: 0;
      }

      @media (prefers-reduced-motion: reduce) {
        & .demo-frame__pointer,
        & .demo-frame__ring {
          animation: none;
        }
      }
    }

    @keyframes demo-frame-nudge {
      0%,
      100% {
        translate: 0 0;
      }

      45% {
        translate: -3px -3px;
      }
    }

    @keyframes demo-frame-ring {
      0% {
        opacity: 0;
        scale: 0.4;
      }

      30% {
        opacity: 1;
      }

      100% {
        opacity: 0;
        scale: 1.5;
      }
    }
  }
</style>
