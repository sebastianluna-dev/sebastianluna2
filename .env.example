# Blue chat (src/pages/api/chat.ts). Without a key the endpoint answers 503 not_configured;
# `npm run dev` answers instead with a marked local demo text over the same protocol.
ANTHROPIC_API_KEY=
# Rate limits of the chat (10 requests / 10 min and 40 a day per visitor, 500 a day for the site).
# Without them each function instance keeps its own counts in memory: set both in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: secret that keys visitor IPs (HMAC) before they become rate-limit keys in Redis, e.g.
# `openssl rand -hex 32`. Without it the Upstash token is used as that secret.
BLUE_IP_SALT=
